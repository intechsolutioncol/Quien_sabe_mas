# Plantilla de variables de entorno. Copia este archivo como .env.local
# y reemplaza los valores; .env.local nunca se sube al repositorio.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreto: solo se usa en el servidor, nunca debe llegar al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# La misma API key de Gemini usada antes en Apps Script.
GEMINI_API_KEY=
